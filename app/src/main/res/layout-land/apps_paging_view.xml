<?xml version="1.0" encoding="utf-8"?>
<org.zmreborn.ApplicationsPagingView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:background="@color/zm_reborn_slate" android:visibility="invisible" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingEnd="@dimen/navigation_strip_size" tools:ignore="RtlSymmetry">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:id="@+id/drawer_search_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/drawer_horizontal_padding" android:paddingTop="@dimen/drawer_vertical_padding" android:paddingEnd="@dimen/drawer_horizontal_padding" android:paddingBottom="@dimen/drawer_grid_spacing">
            <EditText android:id="@+id/drawer_search_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/minimum_touch_target" android:paddingStart="@dimen/space_16" android:paddingEnd="@dimen/minimum_touch_target" android:singleLine="true" android:inputType="text|textNoSuggestions" android:importantForAutofill="no" android:imeOptions="actionDone" android:hint="@string/apps_search_hint" android:textAppearance="@style/TextAppearance.ZmReborn.Body" android:nextFocusDown="@+id/view_pager"/>
            <ImageButton android:id="@+id/drawer_search_clear" android:layout_width="@dimen/minimum_touch_target" android:layout_height="@dimen/minimum_touch_target" android:layout_gravity="end|center_vertical" android:background="@android:color/transparent" android:src="@drawable/ic_menu_close_clear_cancel" android:contentDescription="@string/accessibility_clear_apps_search" android:visibility="gone" android:nextFocusLeft="@+id/drawer_search_input" android:nextFocusDown="@+id/view_pager"/>
        </FrameLayout>
        <org.zmreborn.ViewPager android:id="@+id/view_pager" android:scrollbars="none" android:fadingEdge="none" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:nextFocusUp="@+id/drawer_search_input"/>
    </LinearLayout>
    <TextView android:id="@+id/drawer_search_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/apps_search_empty" android:textAppearance="@style/TextAppearance.ZmReborn.Body" android:visibility="gone"/>
</org.zmreborn.ApplicationsPagingView>
