<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="direction">
        <enum name="vertical" value="0" />
        <enum name="horizontal" value="1" />
    </attr>
    <attr name="defaultScreen" format="integer">
    </attr>
    <attr name="cellWidth" format="dimension">
    </attr>
    <attr name="cellHeight" format="dimension">
    </attr>
    <attr name="longAxisStartPadding" format="dimension">
    </attr>
    <attr name="longAxisEndPadding" format="dimension">
    </attr>
    <attr name="shortAxisStartPadding" format="dimension">
    </attr>
    <attr name="shortAxisEndPadding" format="dimension">
    </attr>
    <attr name="shortAxisCells" format="integer">
    </attr>
    <attr name="longAxisCells" format="integer">
    </attr>
    <attr name="texture" format="reference">
    </attr>
    <attr name="className" format="string">
    </attr>
    <attr name="packageName" format="string">
    </attr>
    <attr name="screen" format="string">
    </attr>
    <attr name="x" format="string">
    </attr>
    <attr name="y" format="string">
    </attr>
    <attr name="spanX" format="string">
    </attr>
    <attr name="spanY" format="string">
    </attr>
    <attr name="icon" format="reference">
    </attr>
    <attr name="title" format="reference">
    </attr>
    <attr name="uri" format="string">
    </attr>
    <attr name="container" format="string">
    </attr>
    <attr name="orientation">
        <enum name="vertical" value="0" />
        <enum name="horizontal" value="1" />
    </attr>
    <attr name="cells" format="integer">
    </attr>
    <attr name="min" format="integer">
    </attr>
    <attr name="max" format="integer">
    </attr>

    <declare-styleable name="DeleteZone">
        <attr name="direction" />
    </declare-styleable>

    <declare-styleable name="CellLayout">
        <attr name="cellWidth" />
        <attr name="cellHeight" />
        <attr name="longAxisStartPadding" />
        <attr name="longAxisEndPadding" />
        <attr name="shortAxisStartPadding" />
        <attr name="shortAxisEndPadding" />
    </declare-styleable>

    <declare-styleable name="Dock">
        <attr name="cellWidth" />
        <attr name="cellHeight" />
        <attr name="orientation" />
    </declare-styleable>

    <declare-styleable name="Favorite">
        <attr name="className" />
        <attr name="packageName" />
        <attr name="screen" />
        <attr name="x" />
        <attr name="y" />
        <attr name="spanX" />
        <attr name="spanY" />
        <attr name="icon" />
        <attr name="title" />
        <attr name="uri" />
        <attr name="container" />
    </declare-styleable>
</resources>
