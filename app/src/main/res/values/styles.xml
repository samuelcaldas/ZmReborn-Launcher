<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WorkspaceIcon">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/zm_reborn_fog</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="WorkspaceIcon.Portrait">
        <item name="android:paddingTop">4dp</item>
        <item name="android:layout_marginLeft">3dp</item>
        <item name="android:layout_marginTop">13dp</item>
        <item name="android:layout_marginRight">3dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:drawablePadding">5dp</item>
    </style>
    <style name="WorkspaceIcon.Landscape">
        <item name="android:paddingTop">2dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
        <item name="android:drawablePadding">3dp</item>
    </style>
    <style name="SearchButton">
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>
    <style name="Theme">
        <item name="android:windowBackground">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="LauncherTheme" parent="@android:style/Theme.Wallpaper.NoTitleBar" />
    <style name="DockBarIcon">
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">center</item>
        <item name="android:drawablePadding">3dp</item>
    </style>
    <style name="SettingsPreferenceStyle">
        <item name="android:layout">@layout/settings_preference</item>
    </style>
    <style name="SettingsPreferenceCategoryStyle">
        <item name="android:layout">@layout/settings_preference_category</item>
    </style>
    <style name="SettingsCheckBoxPreferenceStyle">
        <item name="android:layout">@layout/settings_preference</item>
        <item name="android:widgetLayout">@layout/settings_checkbox_widget</item>
    </style>
    <style name="SettingsTheme" parent="@android:style/Theme.Black">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/zm_reborn_slate</item>
        <item name="android:colorBackground">@color/zm_reborn_slate</item>
        <item name="android:textColorPrimary">@color/zm_reborn_fog</item>
        <item name="android:textColorSecondary">@color/zm_reborn_steel</item>
        <item name="android:preferenceStyle">@style/SettingsPreferenceStyle</item>
        <item name="android:preferenceCategoryStyle">@style/SettingsPreferenceCategoryStyle</item>
        <item name="android:checkBoxPreferenceStyle">@style/SettingsCheckBoxPreferenceStyle</item>
        <item name="android:dialogPreferenceStyle">@style/SettingsPreferenceStyle</item>
    </style>
</resources>
