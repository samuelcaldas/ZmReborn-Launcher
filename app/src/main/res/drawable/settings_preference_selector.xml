<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/m3_ripple_primary">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@color/zm_reborn_fog" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/m3_surface_variant" />
                    <stroke android:width="2dp" android:color="@color/m3_primary" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/m3_surface_variant" />
                    <stroke android:width="2dp" android:color="@color/m3_primary" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
