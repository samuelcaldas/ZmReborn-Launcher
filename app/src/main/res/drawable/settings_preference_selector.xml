<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/zeam_slate" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/zeam_glass" />
            <stroke android:width="1dp" android:color="@color/zeam_amber" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/zeam_slate" />
            <stroke android:width="1dp" android:color="@color/zeam_glass" />
        </shape>
    </item>
</selector>
