<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_12"
    android:paddingBottom="@dimen/space_8"
    android:minHeight="@dimen/settings_row_height"
    android:background="@drawable/settings_preference_selector"
    android:clickable="false"
    android:focusable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@android:id/title"
            android:textAppearance="@style/TextAppearance.ZmReborn.Title"
            android:textColor="@color/m3_on_surface"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@android:id/summary"
            android:textAppearance="@style/TextAppearance.ZmReborn.Label"
            android:textColor="@color/m3_on_surface_variant"
            android:layout_marginTop="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
