ARG BASE_IMAGE=zeam-docker-dev:android35
FROM ${BASE_IMAGE}

ARG API_LEVEL=35
ARG SYSTEM_IMAGE=system-images;android-35;google_apis;x86_64

ENV ANDROID_SDK_ROOT=/home/circleci/android-sdk
ENV ANDROID_AVD_HOME=/root/.android/avd
ENV AVD_NAME=zeam_avd
ENV API_LEVEL=${API_LEVEL}
ENV SYSTEM_IMAGE=${SYSTEM_IMAGE}
ENV EMULATOR_DEVICE=pixel_3a

# Runtime deps for emulator
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        libpulse0 \
        libglib2.0-0 \
        libstdc++6 \
        libx11-6 \
        libxcb1 \
        libxext6 \
        libxi6 \
        libxrender1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libxtst6 \
        libnss3 \
        libcups2t64 \
        libxss1 \
        libasound2t64 \
        libatk1.0-0 \
        libpangocairo-1.0-0 \
        libgtk-3-0 \
        novnc \
        socat \
        websockify \
        x11vnc \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

# Accept SDK licenses; sdkmanager closes stdin after the final prompt, so ignore yes SIGPIPE only.
RUN yes | "${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager" --licenses \
        >/dev/null || [[ "${PIPESTATUS[1]}" -eq 0 ]]

# Validate and install the exact requested runtime image.
RUN [[ "${API_LEVEL}" =~ ^[1-9][0-9]*$ ]] \
    && [[ "${SYSTEM_IMAGE}" == "system-images;android-${API_LEVEL};"* ]] \
    && "${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager" --list \
        | grep -Fq "${SYSTEM_IMAGE}" \
    && "${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager" \
        "${SYSTEM_IMAGE}" < /dev/null \
    && "${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin/sdkmanager" --list_installed \
        | grep -Fq "${SYSTEM_IMAGE}"

EXPOSE 5555 6080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5m --retries=3 \
    CMD bash -ec 'exec 3<>/dev/tcp/127.0.0.1/6080 && "${ANDROID_SDK_ROOT}/platform-tools/adb" get-state | grep -qx device'

COPY tools/emulator-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
